# Copy this file to ~/.swing/.env (mode 0600) or to .env in the working directory.
# .env is gitignored. A variable already set in the shell wins over this file.
# Doctor requires both free keys below. Context.dev is not a dependency and has no key here.
# Recorded choices: docs/decisions/SECTION8_ANSWERS.md

# Required. Earnings calendar only (free tier, /calendar/earnings). Never used for price bars or dividends.
# Without it, earnings come from the yfinance calendar.
FINNHUB_API_KEY=

# Required. Daily bars only when SWING_BARS_PROVIDER=massive (or data.bars_provider = "massive").
# Sent as Authorization: Bearer. The built-in bars default stays yfinance.
# A missing key does not block a fresh yfinance bar.
MASSIVE_API_KEY=

# yfinance (default) or massive. Leave empty to keep the built-in yfinance default.
SWING_BARS_PROVIDER=

# Optional path to a TOML config file.
SWING_CONFIG=

# Data root. Default is ~/.swing (config.toml, .env, universe.txt, book, plans, cache).
SWING_HOME=

# Older name for the data root. SWING_HOME wins when both are set.
SWING_DATA_DIR=
