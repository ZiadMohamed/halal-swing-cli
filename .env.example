# Copy this file to .env and fill in the values you have.
# .env is gitignored. A variable already set in the shell wins over this file.

# Earnings calendar only (free tier, /calendar/earnings). Never used for price bars or dividends.
# Without it, earnings come from the yfinance calendar.
FINNHUB_API_KEY=

# Daily bars when SWING_BARS_PROVIDER=massive. Sent as Authorization: Bearer.
MASSIVE_API_KEY=

# yfinance (default) or massive.
SWING_BARS_PROVIDER=

# Optional path to a TOML config file.
SWING_CONFIG=

# Overrides the data root. macOS default: ~/Library/Application Support/swing
SWING_DATA_DIR=
